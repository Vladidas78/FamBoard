{
  // Butley — Cloudflare Workers Konfiguration.
  // Der Worker heisst weiterhin "famboard": daran haengt die URL, und die
  // bleibt nach Kapitel 6.9 vorerst bestehen.
  // Diese Datei bestimmt, wie Cloudflare das Projekt baut und ausliefert.
  // Nach jeder Änderung hier: committen und pushen, dann deployt Cloudflare neu.

  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "famboard",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],

  // Die App selbst (index.html, sw.js, Icons) liegt in ./public und wird
  // als statische Dateien ausgeliefert. Der Worker greift über env.ASSETS darauf zu.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Der Wecker (C4): alle fünf Minuten ein Cron-Lauf, der fällige Weckrufe
  // sendet — siehe src/weckrufe.js. Bindings NUR hier pflegen, nicht im
  // Dashboard (Falle Kapitel 2.6: das Dashboard wird beim Deploy überschrieben).
  "triggers": { "crons": ["*/5 * * * *"] },

  // Tageslimit und Premium-Staffelung für den Rezept-Import (siehe ANLEITUNG.md).
  // Stufen werden als KV-Einträge gepflegt: tier:<e-mail> = premium | unbegrenzt | gesperrt
  // WECKRUFE (Namespace famboard-weckrufe) trägt die Abo-Kopien (wr:), die
  // Dedup-Vermerke (ws:) und den Heartbeat (wl:stand) des Weckers.
  "kv_namespaces": [
    { "binding": "IMPORT_LIMITS", "id": "69667679030849d3a96dd6ce69379fb8" },
    { "binding": "WECKRUFE", "id": "d9879e8f3a924aafbb6dba2b41d0cc0b" }
  ]
}
